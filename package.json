{
  "name": "qronos-cli",
  "version": "1.0.22",
  "description": "Qronos CLI - Autonomous AI coding agent in your terminal powered by Qronos AI.",
  "license": "MIT",
  "author": "Qronos AI",
  "homepage": "https://qronos.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumaryush18-cyber/qronos-cli.git"
  },
  "bugs": {
    "url": "https://github.com/kumaryush18-cyber/qronos-cli/issues"
  },
  "type": "module",
  "piConfig": {
    "name": "qronos",
    "configDir": ".qronos"
  },
  "bin": {
    "qronos-cli": "dist/index.js",
    "qronos": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "scripts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --outdir dist --splitting --external @earendil-works/pi-coding-agent --banner '#!/usr/bin/env node' && chmod +x dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "postinstall": "node scripts/patch-pi-quit.mjs",
    "patch:pi": "node scripts/patch-pi-quit.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@gravity-ai/api": "1.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.1.0"
  }
}
